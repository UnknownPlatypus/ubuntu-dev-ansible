# List all commands
_default:
    @just --list  --unsorted

# Update this PC via ansible
[working-directory: x'~/workspace/ubuntu-dev-ansible']
update-pc *args:
    git pull
    uv run ansible-playbook --ask-become-pass playbook.yml {{ args }}

# Update home server via ansible
[working-directory: x'~/workspace/home-lab/ansible']
update-home-serv *args:
    git pull
    uv run ansible-playbook playbook.yml {{ args }}

# Free disk space with each tool's own cache clean command
gc:
    pre-commit gc
    prek cache gc
    uv cache prune
    npm cache verify
    pnpm store prune
    brew cleanup
    docker image prune --force
    docker builder prune --force
    flatpak uninstall --unused --assumeyes
    sudo apt-get autoclean
