#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["cyclopts", "rich"]
# ///
"""Prune local and remote branches already merged into the GitHub default branch."""

from __future__ import annotations

import dataclasses
import json
import subprocess
import webbrowser

import cyclopts
from rich.console import Console
from rich.prompt import Confirm

app = cyclopts.App(help=__doc__, default_parameter=cyclopts.Parameter(negative=()))
console = Console()

REMOTE = "origin"
LOCAL_REFS = "refs/heads/"
REMOTE_REFS = f"refs/remotes/{REMOTE}/"
ALWAYS_PROTECTED = frozenset({"HEAD", "main", "master"})
# One request per repository. Older PRs are only caught when Git itself sees the merge.
MERGED_PR_LIMIT = 1_000


@dataclasses.dataclass(frozen=True)
class Ref:
    name: str
    sha: str
    author: str


@dataclasses.dataclass(frozen=True)
class Merged:
    names: frozenset[str]  # branches merged per Git, plus merged PR heads
    shas: frozenset[str]  # tips proven merged: in the base or a merged PR head
    prs: dict[str, str]  # PR head branch -> PR URL


def run(*args: str) -> str:
    result = subprocess.run(args, capture_output=True, text=True, check=False)
    if result.returncode:
        raise SystemExit(f"{' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout


def _git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=False)


def info(message: str) -> None:
    console.print(message, style="dim", markup=False)


def refs(prefix: str, *filters: str) -> list[Ref]:
    """Branches under a ref prefix, sorted by name."""
    ref_format = "%(refname)%09%(objectname)%09%(authoremail:trim)"
    lines = run("git", "for-each-ref", f"--format={ref_format}", *filters, prefix)
    return [
        Ref(name.removeprefix(prefix), sha, author)
        for name, sha, author in (line.split("\t") for line in lines.splitlines())
    ]


def github_repos() -> tuple[list[str], str]:
    """The GitHub repo plus, for a fork, its upstream parent, and the default branch."""
    fields = "nameWithOwner,defaultBranchRef,parent"
    repo = json.loads(run("gh", "repo", "view", "--json", fields))
    names = [repo["nameWithOwner"]]
    if parent := repo["parent"]:
        names.append(f"{parent['owner']['login']}/{parent['name']}")
    return names, repo["defaultBranchRef"]["name"]


def upstream_remotes(repos: list[str]) -> list[str]:
    """Remotes pointing at one of the GitHub repos: merged work lands on their default branch."""
    suffixes = tuple(f"{sep}{repo.lower()}" for repo in repos for sep in "/:")
    remotes = (line.split() for line in run("git", "remote", "-v").splitlines())
    matching = {
        name
        for name, url, _ in remotes
        if url.lower().removesuffix(".git").endswith(suffixes)
    }
    return sorted(matching) or [REMOTE]


def fetch_merged(repos: list[str], default_branch: str) -> Merged:
    # In a fork, origin's default branch lags behind the upstream one.
    remotes = upstream_remotes(repos)
    info("Fetching full git history")
    to_fetch = sorted({REMOTE, *remotes})
    run("git", "fetch", "--multiple", "--prune", "--quiet", *to_fetch)

    bases = [f"{remote}/{default_branch}" for remote in remotes]
    info(f"Checking for merged branches on {', '.join(bases)}")
    merged_filters = [f"--merged={base}" for base in bases]
    in_base = [
        ref
        for prefix in (LOCAL_REFS, REMOTE_REFS)
        for ref in refs(prefix, *merged_filters)
    ]
    names = {ref.name for ref in in_base}
    shas = {ref.sha for ref in in_base}

    # Squash and rebase merges leave no trace in Git: only GitHub knows about them.
    prs: dict[str, str] = {}
    for repo in repos:
        info(f"Checking for merged PRs on {repo}")
        fields = "headRefName,headRefOid,url"
        limit = str(MERGED_PR_LIMIT)
        output = run(
            *("gh", "pr", "list", "--repo", repo, "--state", "merged"),
            *("--json", fields, "--limit", limit),
        )
        for pr in json.loads(output):
            prs.setdefault(pr["headRefName"], pr["url"])
            shas.add(pr["headRefOid"])

    names |= prs.keys()
    info(f"Found {len(names)} merged branches")
    return Merged(frozenset(names), frozenset(shas), prs)


def worktrees_by_branch() -> dict[str, str]:
    """Branch name -> linked worktree path, skipping the main worktree listed first."""
    worktrees: dict[str, str] = {}
    blocks = run("git", "worktree", "list", "--porcelain").strip().split("\n\n")
    for block in blocks[1:]:
        attrs = dict(line.partition(" ")[::2] for line in block.splitlines())
        if branch := attrs.get("branch"):
            worktrees[branch.removeprefix(LOCAL_REFS)] = attrs["worktree"]
    return worktrees


def confirm(names: list[str], label: str) -> bool:
    if not names:
        console.print(f"No {label.lower()} branches to clean!", style="green")
        return False
    console.print(f"{label} branches to clean", style="bold")
    for name in names:
        console.print(f"  {name}", style="cyan", markup=False)
    return Confirm.ask("Delete these branches?", default=False)


def _failed(name: str, result: subprocess.CompletedProcess[str]) -> None:
    # Only the first line: git follows its errors with hints we act on ourselves.
    error = result.stderr.strip().partition("\n")[0]
    console.print(f"✗ {name}  {error}", style="red", markup=False)


def remove_worktree(name: str, worktree: str) -> bool:
    info(f"  Removing worktree {worktree}")
    result = _git("worktree", "remove", worktree)
    if not result.returncode:
        return True
    _failed(name, result)
    subprocess.run(["git", "-C", worktree, "status", "--short"], check=False)
    if not Confirm.ask(
        "  Force remove worktree? Pending changes will be lost", default=False
    ):
        return False
    subprocess.run(["git", "worktree", "remove", "--force", worktree], check=False)
    return True


def delete_local_branch(ref: Ref, merged: Merged, worktree: str | None) -> None:
    if worktree and not remove_worktree(ref.name, worktree):
        return
    # `-d` only compares with HEAD and the upstream, so it rejects squash merges.
    proven = ref.sha in merged.shas
    result = _git("branch", "-D" if proven else "-d", ref.name)
    if not result.returncode:
        console.print(f"✓ {ref.name}", style="green", markup=False)
        return

    _failed(ref.name, result)
    if proven:
        return
    url = merged.prs.get(ref.name)
    if url and Confirm.ask("  See PR on GitHub?", default=True):
        webbrowser.open(url)
    if Confirm.ask("  Force delete?", default=False):
        subprocess.run(["git", "branch", "-D", ref.name], check=False)


def prune_local_branches(merged: Merged, protected: frozenset[str]) -> None:
    console.print("Pruning local branches…", style="bold")
    to_clean = [
        ref
        for ref in refs(LOCAL_REFS)
        if ref.name not in protected
        and (ref.name in merged.names or ref.sha in merged.shas)
    ]
    if not confirm([ref.name for ref in to_clean], "Local"):
        return

    worktrees = worktrees_by_branch()
    for ref in to_clean:
        delete_local_branch(ref, merged, worktrees.get(ref.name))
    console.print("Done cleaning local branches!", style="bold green")


def prune_remote_branches(merged: Merged, protected: frozenset[str]) -> None:
    console.print("Pruning remote branches…", style="bold")
    email = run("git", "config", "user.email").strip()
    # A remote delete has no safety net: only tips I authored that are proven merged.
    to_clean = [
        ref.name
        for ref in refs(REMOTE_REFS)
        if ref.name not in protected and ref.author == email and ref.sha in merged.shas
    ]
    if not confirm(to_clean, "Remote"):
        return

    result = _git("push", REMOTE, "--delete", *to_clean)
    if result.returncode:
        error = result.stderr.strip()
        console.print(f"Push failed: {error}", style="red", markup=False)
    else:
        console.print(f"Pruned {len(to_clean)} remote branches!", style="bold green")


@app.default
def main(*, protected: tuple[str, ...] = ()) -> None:
    """
    Parameters
    ----------
    protected
        Extra branches to keep, on top of main/master, the default and the current branch.
    """
    console.print("Fetching merged branches…", style="bold")
    repos, default_branch = github_repos()
    merged = fetch_merged(repos, default_branch)
    current_branch = run("git", "branch", "--show-current").strip()
    keep = ALWAYS_PROTECTED | {*protected, default_branch, current_branch}
    prune_local_branches(merged, keep)
    prune_remote_branches(merged, keep)


if __name__ == "__main__":
    app()
