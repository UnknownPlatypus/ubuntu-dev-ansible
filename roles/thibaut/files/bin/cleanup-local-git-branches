#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["cyclopts", "rich"]
# ///
"""Clean up local and remote branches after GitHub PRs are merged."""

from __future__ import annotations

import dataclasses
import json
import logging
import subprocess
from collections.abc import Iterable
from typing import Annotated

import cyclopts
from rich.console import Console
from rich.markup import escape
from rich.prompt import Confirm
from rich.text import Text

app = cyclopts.App(help=__doc__, default_parameter=cyclopts.Parameter(negative=()))
logger = logging.getLogger(__name__)
console = Console()

ALWAYS_PROTECTED = frozenset({"main", "master"})
# Renovate owns its upstream branches: never delete them remotely.
REMOTE_SKIP_PREFIXES = ("renovate/",)
# One request per repository replaces a request for every branch. Older PRs simply remain
# untouched unless Git itself can prove the branch was merged.
MERGED_PR_LIMIT = 1_000


@dataclasses.dataclass(frozen=True)
class Repo:
    name: str
    default_branch: str | None


@dataclasses.dataclass(frozen=True)
class Branch:
    name: str
    upstream: str | None
    gone: bool

    def pr_heads(self, protected: set[str]) -> tuple[str, ...]:
        """Possible PR heads: the local name and, if renamed, its upstream name."""
        pushed = self.upstream.split("/", 1)[-1] if self.upstream else self.name
        if pushed == self.name or pushed in protected:
            return (self.name,)
        return (self.name, pushed)


@dataclasses.dataclass(frozen=True)
class Verdict:
    reason: str
    review: bool = False


def run_cmd(command_args: list[str]) -> str:
    result = subprocess.run(command_args, capture_output=True, text=True, check=False)
    if result.returncode:
        logger.debug("%s failed: %s", " ".join(command_args), result.stderr.strip())
    return result.stdout


def run_ok(command_args: list[str]) -> bool:
    return not subprocess.run(command_args, capture_output=True, check=False).returncode


def _git(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=False)


def _branch_names(ref_pattern: str) -> list[str]:
    return run_cmd(
        ["git", "for-each-ref", "--format=%(refname:short)", ref_pattern]
    ).splitlines()


def get_local_branches() -> list[Branch]:
    fields = ("refname:short", "upstream:short", "upstream:track")
    ref_format = "%09".join(f"%({field})" for field in fields)
    return [
        Branch(name, upstream or None, gone=track == "[gone]")
        for name, upstream, track in (
            line.split("\t")
            for line in run_cmd(
                ["git", "for-each-ref", f"--format={ref_format}", "refs/heads/"]
            ).splitlines()
        )
    ]


def get_remote_branches(remote: str = "origin") -> set[str]:
    prefix = f"{remote}/"
    return {
        branch.removeprefix(prefix)
        for branch in _branch_names(f"refs/remotes/{remote}/")
        if not branch.endswith("/HEAD")
    }


def get_worktrees() -> dict[str, str]:
    """Branch name -> linked worktree path, skipping the main worktree listed first."""
    worktrees: dict[str, str] = {}
    blocks = run_cmd(["git", "worktree", "list", "--porcelain"]).strip().split("\n\n")
    for block in blocks[1:]:
        path, *lines = block.splitlines()
        for line in lines:
            if line.startswith("branch refs/heads/"):
                name = line.removeprefix("branch refs/heads/")
                worktrees[name] = path.removeprefix("worktree ")
    return worktrees


def _default_branch(repo_json: dict) -> str | None:
    return (repo_json.get("defaultBranchRef") or {}).get("name")


def get_repos() -> list[Repo]:
    """The resolved GitHub repo and, for a fork, its upstream parent."""
    fields = "nameWithOwner,defaultBranchRef,parent"
    resolved = json.loads(run_cmd(["gh", "repo", "view", "--json", fields]) or "{}")
    if not resolved:
        raise SystemExit("Could not resolve the GitHub repo; is gh authenticated?")

    repos = [Repo(resolved["nameWithOwner"], _default_branch(resolved))]
    if parent := resolved["parent"]:
        name = f"{parent['owner']['login']}/{parent['name']}"
        upstream = json.loads(
            run_cmd(["gh", "repo", "view", name, "--json", "defaultBranchRef"]) or "{}"
        )
        repos.append(Repo(name, _default_branch(upstream)))
    return repos


def get_base_ref(repos: list[Repo], remote: str = "origin") -> str | None:
    """The remote-tracking ref merged work lands on, such as ``origin/main``."""
    for repo in repos:
        ref = f"{remote}/{repo.default_branch}"
        if repo.default_branch and run_ok(["git", "rev-parse", "--verify", ref]):
            return ref
    return None


def merged_prs(repos: Iterable[Repo]) -> dict[str, str]:
    """Recent merged PR head names, fetched once per repository."""
    result: dict[str, str] = {}
    for repo in repos:
        output = run_cmd(
            [
                "gh",
                "pr",
                "list",
                "--repo",
                repo.name,
                "--state",
                "merged",
                "--json",
                "number,headRefName",
                "--limit",
                str(MERGED_PR_LIMIT),
            ]
        )
        for pr in json.loads(output) if output.strip() else []:
            result.setdefault(pr["headRefName"], f"{repo.name}#{pr['number']}")
    return result


def _is_rebased_into(branch: str, base: str) -> bool:
    """Every commit has a patch-id twin in base, as after a rebase merge."""
    commits = run_cmd(["git", "cherry", base, branch]).splitlines()
    return bool(commits) and all(commit.startswith("-") for commit in commits)


def _merged_pr(branch: Branch, prs: dict[str, str], protected: set[str]) -> str | None:
    return next((prs[head] for head in branch.pr_heads(protected) if head in prs), None)


def classify_branch(
    branch: Branch,
    base: str | None,
    prs: dict[str, str],
    protected: set[str],
) -> Verdict | None:
    """Classify a branch without treating a deleted upstream as proof of a merge."""
    if base and run_ok(["git", "merge-base", "--is-ancestor", branch.name, base]):
        return Verdict(f"in {base}")
    if base and _is_rebased_into(branch.name, base):
        return Verdict(f"rebased into {base}")

    reasons = []
    if pr := _merged_pr(branch, prs, protected):
        reasons.append(f"merged PR {pr}")
    if branch.gone:
        reasons.append(f"upstream {branch.upstream} deleted")
    if reasons:
        return Verdict("; ".join(reasons), review=True)
    return None


def classify_branches(
    branches: Iterable[Branch],
    base: str | None,
    prs: dict[str, str],
    protected: set[str],
) -> dict[str, Verdict]:
    return {
        branch.name: verdict
        for branch in branches
        if (verdict := classify_branch(branch, base, prs, protected)) is not None
    }


def classify_remote_branches(
    branches: Iterable[str], base: str | None, prs: dict[str, str], remote: str
) -> dict[str, Verdict]:
    verdicts: dict[str, Verdict] = {}
    for name in branches:
        ref = f"{remote}/{name}"
        if base and run_ok(["git", "merge-base", "--is-ancestor", ref, base]):
            verdicts[name] = Verdict(f"in {base}")
        elif base and _is_rebased_into(ref, base):
            verdicts[name] = Verdict(f"rebased into {base}")
        elif pr := prs.get(name):
            verdicts[name] = Verdict(f"merged PR {pr}", review=True)
    return verdicts


def _report(
    header: str, verdicts: dict[str, Verdict], worktrees: dict[str, str]
) -> None:
    if not verdicts:
        return
    console.print(f"{header} ({len(verdicts)}):", style="bold")
    for name, verdict in sorted(verdicts.items()):
        line = Text.assemble(("  " + name, "cyan"), f" — {verdict.reason}")
        if path := worktrees.get(name):
            line.append(f" (checked out at {path})", style="yellow")
        console.print(line)


def _failed(name: str, stderr: str) -> None:
    # Only the first line: git follows its errors with hints we act on ourselves.
    error = stderr.strip().partition("\n")[0]
    console.print(f"✗ {name}  {error}", style="red", markup=False)


def delete_local_branch(name: str, worktree: str | None) -> None:
    if worktree:
        if not Confirm.ask(f"  Remove worktree {escape(worktree)} too?", default=False):
            return
        console.print(f"  Removing worktree {worktree}…", style="yellow", markup=False)
        result = _git(["worktree", "remove", "--force", worktree])
        if result.returncode:
            _failed(name, result.stderr)
            return
    result = _git(["branch", "-d", name])
    if result.returncode and "not fully merged" in result.stderr:
        if not Confirm.ask(f"  Force delete {escape(name)}?", default=False):
            return
        result = _git(["branch", "-D", name])
    if result.returncode:
        _failed(name, result.stderr)
    else:
        console.print(f"✓ {name}", style="green", markup=False)


def cleanup_local_git_branches(
    protected: set[str], base: str | None, prs: dict[str, str], dry_run: bool
) -> None:
    console.print("Pruning local branches…", style="bold")
    branches = [
        branch for branch in get_local_branches() if branch.name not in protected
    ]
    verdicts = classify_branches(branches, base, prs, protected)
    worktrees = get_worktrees()
    safe = {name: verdict for name, verdict in verdicts.items() if not verdict.review}
    review = {name: verdict for name, verdict in verdicts.items() if verdict.review}

    if not verdicts:
        console.print("No local branches to clean!", style="green")
        return

    _report("Local branches safe to delete", safe, worktrees)
    _report("Local branches needing review", review, worktrees)
    if dry_run:
        console.print("Dry run: no local branches deleted.", style="dim")
        return
    for label, candidates in (("safe", safe), ("review-required", review)):
        if candidates and Confirm.ask(
            f"Delete {len(candidates)} {label} local branches?", default=False
        ):
            for name in sorted(candidates):
                delete_local_branch(name, worktrees.get(name))


def cleanup_remote_git_branches(
    protected: set[str],
    base: str | None,
    prs: dict[str, str],
    remote: str,
    dry_run: bool,
) -> None:
    console.print("Pruning remote branches…", style="bold")
    branches = {
        name
        for name in get_remote_branches(remote) - protected
        if not name.startswith(REMOTE_SKIP_PREFIXES)
    }
    verdicts = classify_remote_branches(branches, base, prs, remote)
    safe = {name: verdict for name, verdict in verdicts.items() if not verdict.review}
    review = {name: verdict for name, verdict in verdicts.items() if verdict.review}

    if not verdicts:
        console.print("No remote branches to clean!", style="green")
        return

    _report(f"Remote {remote} branches safe to delete", safe, {})
    _report(f"Remote {remote} branches needing review", review, {})
    if dry_run:
        console.print("Dry run: no remote branches deleted.", style="dim")
        return
    for label, candidates in (("safe", safe), ("review-required", review)):
        if candidates and Confirm.ask(
            f"Delete {len(candidates)} {label} remote branches?", default=False
        ):
            result = _git(["push", remote, "--delete", *sorted(candidates)])
            if result.returncode:
                _failed("push", result.stderr)
            else:
                console.print(
                    f"✓ Pruned {len(candidates)} remote branches", style="green"
                )


@app.default
def main(
    *,
    protected: tuple[str, ...] = (),
    dry_run: bool = False,
    no_fetch: bool = False,
    verbose: Annotated[bool, cyclopts.Parameter(alias="-v")] = False,
) -> None:
    """
    Parameters
    ----------
    protected
        Extra branches to keep, on top of main/master and each repository's default branch.
    no_fetch
        Use existing remote-tracking refs. This is quicker but may miss recent merges or deletions.
    """
    if verbose:
        logging.basicConfig(level=logging.DEBUG, format="%(message)s")

    console.print("Fetching merged PRs…", style="bold")
    repos = get_repos()
    protected_branches = (
        ALWAYS_PROTECTED
        | set(protected)
        | {repo.default_branch for repo in repos if repo.default_branch}
    )
    if not no_fetch:
        run_cmd(["git", "fetch", "origin", "--prune"])

    base = get_base_ref(repos)
    if base is None:
        console.print(
            "No remote-tracking default branch; Git-only checks are unavailable.",
            style="yellow",
        )

    # This is deliberately one request per repository, shared by local and remote cleanup.
    prs = merged_prs(repos)
    cleanup_local_git_branches(protected_branches, base, prs, dry_run)
    cleanup_remote_git_branches(protected_branches, base, prs, "origin", dry_run)


if __name__ == "__main__":
    app()
