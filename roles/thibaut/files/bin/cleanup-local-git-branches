#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["cyclopts"]
# ///
"""Cleanup local git branches that have been merged via GitHub PRs."""

from __future__ import annotations

import concurrent.futures
import dataclasses
import functools
import json
import logging
import subprocess
from collections import defaultdict
from collections.abc import Iterable
from typing import Annotated

import cyclopts

app = cyclopts.App(help=__doc__, default_parameter=cyclopts.Parameter(negative=()))
logger = logging.getLogger(__name__)

ALWAYS_PROTECTED = frozenset({"main", "master"})
# How far back to read merged PR titles when looking for a squash merge.
MERGED_TITLE_SCAN = 200


@dataclasses.dataclass(frozen=True)
class Repo:
    name: str
    default_branch: str | None


@dataclasses.dataclass(frozen=True)
class Branch:
    name: str
    sha: str
    upstream: str | None
    gone: bool

    def pr_heads(self, protected: set[str]) -> tuple[str, ...]:
        """Head names a PR could carry: the local name, plus the pushed one when it was renamed.

        A branch that merely tracks the default branch has no pushed name of its own, and querying
        that name would match whatever PR once merged from it.
        """
        pushed = self.upstream.split("/", 1)[-1] if self.upstream else self.name
        if pushed == self.name or pushed in protected:
            return (self.name,)
        return (self.name, pushed)


@dataclasses.dataclass(frozen=True)
class Verdict:
    reason: str
    force: bool
    """Git disagrees the branch is merged, so only `git branch -D` can remove it."""


def run_cmd(command_args: list[str]) -> str:
    result = subprocess.run(command_args, capture_output=True, text=True, check=False)
    if result.returncode:
        logger.debug(f"{' '.join(command_args)} failed: {result.stderr.strip()}")
    return result.stdout


def run_ok(command_args: list[str]) -> bool:
    return not subprocess.run(command_args, capture_output=True, check=False).returncode


def _branch_names(ref_pattern: str) -> list[str]:
    return run_cmd(
        ["git", "for-each-ref", "--format=%(refname:short)", ref_pattern]
    ).splitlines()


def get_local_branches() -> list[Branch]:
    fields = ("refname:short", "objectname:short", "upstream:short", "upstream:track")
    ref_format = "%09".join(f"%({field})" for field in fields)
    return [
        Branch(name, sha, upstream or None, gone=track == "[gone]")
        for name, sha, upstream, track in (
            line.split("\t")
            for line in run_cmd(
                ["git", "for-each-ref", f"--format={ref_format}", "refs/heads/"]
            ).splitlines()
        )
    ]


def get_remote_branches(remote: str = "origin") -> set[str]:
    prefix = f"{remote}/"
    return {
        branch.removeprefix(prefix)
        for branch in _branch_names(f"refs/remotes/{remote}/")
        if not branch.endswith("/HEAD")
    }


def get_worktrees() -> dict[str, str]:
    """Branch name -> worktree path, for branches git refuses to delete."""
    worktrees: dict[str, str] = {}
    path = ""
    for line in run_cmd(["git", "worktree", "list", "--porcelain"]).splitlines():
        if line.startswith("worktree "):
            path = line.removeprefix("worktree ")
        elif line.startswith("branch refs/heads/"):
            worktrees[line.removeprefix("branch refs/heads/")] = path
    return worktrees


def disk_usage(path: str) -> str:
    return run_cmd(["du", "-sh", path]).partition("\t")[0] or "?"


def _default_branch(repo_json: dict) -> str | None:
    return (repo_json.get("defaultBranchRef") or {}).get("name")


def get_repos() -> list[Repo]:
    """Repos that can host PRs for this clone: the one gh resolves to and, for a fork, its upstream."""
    fields = "nameWithOwner,defaultBranchRef,parent"
    resolved = json.loads(run_cmd(["gh", "repo", "view", "--json", fields]) or "{}")
    if not resolved:
        raise SystemExit("Could not resolve the GitHub repo, is `gh` authenticated?")

    repos = [Repo(resolved["nameWithOwner"], _default_branch(resolved))]
    if parent := resolved["parent"]:
        name = f"{parent['owner']['login']}/{parent['name']}"
        upstream = json.loads(
            run_cmd(["gh", "repo", "view", name, "--json", "defaultBranchRef"]) or "{}"
        )
        repos.append(Repo(name, _default_branch(upstream)))
    return repos


def get_base_ref(repos: list[Repo], remote: str = "origin") -> str | None:
    """The remote-tracking ref merged work lands on, e.g. `origin/main`."""
    for repo in repos:
        ref = f"{remote}/{repo.default_branch}"
        if repo.default_branch and run_ok(["git", "rev-parse", "--verify", ref]):
            return ref
    return None


def _merged_pr(heads: Iterable[str], repos: list[Repo]) -> str | None:
    """First `repo#number` with a merged PR for one of these head names."""
    for head in heads:
        for repo in repos:
            result = run_cmd(
                [
                    "gh",
                    "pr",
                    "list",
                    "--repo",
                    repo.name,
                    "--head",
                    head,
                    "--state",
                    "merged",
                    "--json",
                    "number",
                    "--limit",
                    "1",
                ]
            )
            if prs := json.loads(result) if result.strip() else []:
                return f"{repo.name}#{prs[0]['number']}"
    return None


def _is_rebased_into(branch: str, base: str) -> bool:
    """Every commit has a patch-id twin in base, which a rebase merge leaves behind."""
    commits = run_cmd(["git", "cherry", base, branch]).splitlines()
    return bool(commits) and all(commit.startswith("-") for commit in commits)


def _classify(
    branch: Branch, repos: list[Repo], base: str | None, protected: set[str]
) -> Verdict | None:
    """Why the branch is deletable, cheapest and most certain check first."""
    logger.debug(f"Checking {branch.name}")
    if base:
        if run_ok(["git", "merge-base", "--is-ancestor", branch.name, base]):
            return Verdict(f"already in {base}", force=False)
        if _is_rebased_into(branch.name, base):
            return Verdict(f"rebased into {base}", force=True)
    heads = branch.pr_heads(protected)
    if pr := _merged_pr(heads, repos):
        renamed = f" (as {branch.upstream})" if heads[-1] != branch.name else ""
        return Verdict(f"merged PR {pr}{renamed}", force=True)
    if branch.gone:
        return Verdict(f"upstream {branch.upstream} was deleted", force=True)
    return None


def classify_branches(
    branches: list[Branch], repos: list[Repo], base: str | None, protected: set[str]
) -> dict[str, Verdict]:
    with concurrent.futures.ThreadPoolExecutor() as executor:
        verdicts = executor.map(
            functools.partial(_classify, repos=repos, base=base, protected=protected),
            branches,
        )
    return {
        branch.name: verdict
        for branch, verdict in zip(branches, verdicts, strict=True)
        if verdict is not None
    }


def get_merged_branches(branches: set[str], repos: list[Repo]) -> set[str]:
    """Check which branches have merged PRs using gh CLI."""
    with concurrent.futures.ThreadPoolExecutor() as executor:
        results = executor.map(
            lambda branch: (branch, _merged_pr((branch,), repos)), branches
        )
    return {branch for branch, pr in results if pr}


def merged_pr_titles(repos: list[Repo]) -> dict[str, str]:
    """Merged PR title -> `repo#number`. A squash merge keeps the title but not the branch."""
    titles: dict[str, str] = {}
    for repo in repos:
        result = run_cmd(
            [
                "gh",
                "pr",
                "list",
                "--repo",
                repo.name,
                "--state",
                "merged",
                "--json",
                "number,title",
                "--limit",
                str(MERGED_TITLE_SCAN),
            ]
        )
        for pr in json.loads(result) if result.strip() else []:
            titles.setdefault(pr["title"], f"{repo.name}#{pr['number']}")
    return titles


def suspected_squash_merges(
    branches: list[Branch], repos: list[Repo], base: str
) -> dict[str, str]:
    """Branches reusing a merged PR title, which no head or patch-id lookup can match."""
    titles = merged_pr_titles(repos)
    suspected = {}
    for branch in branches:
        subjects = run_cmd(
            ["git", "log", "--format=%s", f"{base}..{branch.name}"]
        ).splitlines()
        for pr in filter(None, (titles.get(subject) for subject in subjects)):
            suspected[branch.name] = f"a commit reuses the title of merged PR {pr}"
            break
    return suspected


def _report(header: str, lines: list[str]) -> None:
    if lines:
        logger.info(header)
        for line in lines:
            logger.info(f"  - {line}")
        logger.info("")


def delete_branches(deletable: dict[str, Verdict]) -> None:
    """Force-delete only what git cannot see as merged, so a misjudged branch fails loudly."""
    for force in (False, True):
        names = sorted(name for name, v in deletable.items() if v.force is force)
        if names:
            subprocess.run(
                ["git", "branch", "-D" if force else "-d", *names], check=False
            )


def cleanup_local_git_branches(
    protected_branches: set[str],
    repos: list[Repo],
    base: str | None,
    dry_run: bool = False,
) -> None:
    branches = [b for b in get_local_branches() if b.name not in protected_branches]
    logger.debug(f"Local branches (excluding protected): {sorted(b.name for b in branches)}")

    verdicts = classify_branches(branches, repos, base, protected_branches)
    worktrees = get_worktrees()

    by_sha: dict[str, list[str]] = defaultdict(list)
    for branch in branches:
        by_sha[branch.sha].append(branch.name)
    _report(
        "Duplicate branches, same commit:",
        [f"{sha}: {', '.join(sorted(names))}" for sha, names in sorted(by_sha.items()) if len(names) > 1],
    )

    _report(
        "Merged but checked out, free the worktree first:",
        [
            f"{name}: {worktrees[name]} ({disk_usage(worktrees[name])})"
            for name in sorted(verdicts.keys() & worktrees.keys())
        ],
    )

    if base:
        undecided = [b for b in branches if b.name not in verdicts]
        _report(
            "Likely merged, verify before deleting:",
            [
                f"{name}: {reason}"
                for name, reason in sorted(
                    suspected_squash_merges(undecided, repos, base).items()
                )
            ],
        )

    deletable = {n: v for n, v in verdicts.items() if n not in worktrees}
    if not deletable:
        logger.info("No local branches to cleanup!")
        return

    logger.info("Merged local branches:")
    for name, verdict in sorted(deletable.items()):
        logger.info(f"  - {name}: {verdict.reason}")

    if dry_run:
        logger.info("\nDry run, no local branches deleted.")
    elif input("\nDelete these local branches? (y/n) ").strip().lower() == "y":
        delete_branches(deletable)
        logger.info("Done!")
    else:
        logger.info("Aborted.")


def cleanup_remote_git_branches(
    protected_branches: set[str],
    repos: list[Repo],
    remote: str = "origin",
    dry_run: bool = False,
) -> None:
    remote_branches = get_remote_branches(remote) - protected_branches
    logger.debug(f"Remote branches (excluding protected): {sorted(remote_branches)}")

    branches_to_delete = sorted(get_merged_branches(remote_branches, repos))

    if not branches_to_delete:
        logger.info("No remote branches to cleanup!")
        return

    logger.info("Merged remote branches:")
    for branch in branches_to_delete:
        logger.info(f"  - {remote}/{branch}")

    if dry_run:
        logger.info("\nDry run, no remote branches deleted.")
        return

    if input("\nDelete these remote branches? (y/n) ").strip().lower() == "y":
        subprocess.run(
            ["git", "push", remote, "--delete", *branches_to_delete], check=False
        )
        logger.info("Done!")
    else:
        logger.info("Aborted.")


@app.default
def main(
    *,
    protected: tuple[str, ...] = (),
    dry_run: bool = False,
    verbose: Annotated[bool, cyclopts.Parameter(alias="-v")] = False,
) -> None:
    """
    Parameters
    ----------
    protected
        Extra branches to keep, on top of main/master and each repo's default branch.
    """
    logging.basicConfig(
        level=logging.DEBUG if verbose else logging.INFO,
        format="[%(levelname)s] %(message)s",
    )

    repos = get_repos()
    logger.debug(f"Looking for merged PRs in: {[repo.name for repo in repos]}")

    protected_branches = (
        ALWAYS_PROTECTED
        | set(protected)
        | {repo.default_branch for repo in repos if repo.default_branch}
    )
    logger.debug(f"Protected branches: {sorted(protected_branches)}")

    # Both passes read remote-tracking refs, so prune before either of them looks.
    run_cmd(["git", "fetch", "origin", "--prune"])

    base = get_base_ref(repos)
    if base is None:
        logger.warning("No remote-tracking default branch, falling back to PR lookups.")

    cleanup_local_git_branches(
        protected_branches=protected_branches,
        repos=repos,
        base=base,
        dry_run=dry_run,
    )

    logger.info("")
    cleanup_remote_git_branches(
        protected_branches=protected_branches,
        repos=repos,
        dry_run=dry_run,
    )


if __name__ == "__main__":
    app()
